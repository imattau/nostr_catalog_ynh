[Unit]
Description=Nostr-backed YunoHost application catalogue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nostr_catalog
Group=nostr_catalog
EnvironmentFile=-/etc/nostr-catalogd/nostr-catalogd.env
ExecStart=/var/lib/nostr-catalogd/nostr-catalogd --listen 127.0.0.1:8090 --cache /var/lib/nostr-catalogd/catalogue-cache.json
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nostr-catalogd

[Install]
WantedBy=multi-user.target
