#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

get__relays() {
	ynh_app_setting_get --app="$app" --key=relays
}

set__relays() {
	ynh_app_setting_set --app="$app" --key=relays --value="$relays"
	render_daemon_env
	ynh_exec_warn_less systemctl restart "$service_name.service"
}

get__trusted_publishers() {
	display_key_list "$(ynh_app_setting_get --app="$app" --key=trusted_publishers)"
}

set__trusted_publishers() {
	trusted_publishers="$(normalize_key_list "$trusted_publishers")"
	ynh_app_setting_set --app="$app" --key=trusted_publishers --value="$trusted_publishers"
	render_daemon_env
	ynh_exec_warn_less systemctl restart "$service_name.service"
}

get__trusted_curators() {
	display_key_list "$(ynh_app_setting_get --app="$app" --key=trusted_curators)"
}

set__trusted_curators() {
	trusted_curators="$(normalize_key_list "$trusted_curators")"
	ynh_app_setting_set --app="$app" --key=trusted_curators --value="$trusted_curators"
	render_daemon_env
	ynh_exec_warn_less systemctl restart "$service_name.service"
}

get__minimum_endorsements() {
	ynh_app_setting_get --app="$app" --key=minimum_endorsements
}

set__minimum_endorsements() {
	ynh_app_setting_set --app="$app" --key=minimum_endorsements --value="$minimum_endorsements"
	render_daemon_env
	ynh_exec_warn_less systemctl restart "$service_name.service"
}

run__refresh() {
	ynh_exec_warn_less systemctl restart "$service_name.service"
}

get__publisher_npub() {
	cat "$publisher_npub_file"
}

run__publish() {
	if [[ "$repository_url" != https://* || "$repository_url" == *"@"* ]]; then
		ynh_die "The application repository must be an HTTPS URL without embedded credentials"
	fi
	if [ -z "${ref:-}" ]; then
		ref="main"
	fi
	local relays
	relays="$(ynh_app_setting_get --app="$app" --key=relays)"
	if [ -z "$relays" ]; then
		ynh_die "Configure at least one Nostr relay before publishing"
	fi
	ynh_print_info "Verifying and publishing $repository_url at ref $ref..."
	"$install_dir/nostr-ynh" publish \
		--repository-url "$repository_url" \
		--ref "$ref" \
		--private-key-file "$publisher_key_file" \
		--relays "$relays"
}

ynh_app_config_run "$1"
